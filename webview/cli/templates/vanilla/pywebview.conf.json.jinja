{
  "$schema": "https://pywebview.flowrl.com/schemas/pywebview.conf.schema.json",
  "productName": "{{ product_name }}",
  "version": "0.1.0",
  "identifier": "{{ identifier }}",
  "entry": "main.py",
  "frontendDist": "frontend",
  "frontendDev": {
    "command": null,
    "url": null,
    "watch": ["frontend"]
  },
  "window": {
    "title": "{{ product_name }}",
    "width": 1024,
    "height": 768,
    "resizable": true,
    "frameless": false
  },
  "bundle": {
    "targets": [],
    "icon": null,
    "resources": ["frontend/**"],
    "pyinstaller": {
      "onefile": false,
      "excludes": [],
      "extraArgs": []
    },
    "windows": {
      "webview2RuntimePath": null,
      "webview2InstallMode": "downloadBootstrapper"
    },
    "linux": {
      "webkitgtkPackage": "gir1.2-webkit2-4.1",
      "debDepends": ["libwebkit2gtk-4.1-0"]
    },
    "macos": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": null,
      "entitlements": null
    }
  },
  "mobile": {
    "android": { "buildozerSpecOverrides": {} },
    "ios": { "enabled": false }
  }
}
